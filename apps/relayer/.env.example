# Cross-Chain Relayer Configuration

# 1. Network Configuration
# Set this to your chosen network (e.g. Sepolia RPC). If blank, defaults to local http://127.0.0.1:8545
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# 2. Relayer Identity
# The private key of the Ethereum account acting as the relayer. Needs ETH for gas.
PRIVATE_KEY=0x...

# 3. Contract Addresses
# Obtain these after running the hardhat deploy script on the public testnet
CLIENT_GATEWAY_ADDRESS=0x...
JOB_ORCHESTRATOR_ADDRESS=0x...
