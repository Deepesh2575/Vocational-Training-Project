# Worker Node Configuration

# 1. Network Configuration
# Set this to your chosen network (e.g. Sepolia RPC). If blank, defaults to local http://127.0.0.1:8545
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# 2. Worker Identity
# The private key of the Ethereum account acting as the worker. Needs Sepolia ETH for gas.
PRIVATE_KEY=0x...

# 3. Contract Addresses
# Obtain this after running the hardhat deploy script on the public testnet
JOB_ORCHESTRATOR_ADDRESS=0x...

# 4. Storage Configuration
# Pinata API Keys for real IPFS integration (Required for uploading job results globally)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
